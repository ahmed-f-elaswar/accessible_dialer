<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Required for in-app voice search (Google-style live transcription in the
         Contacts search field). The system speech recognizer (Google app / OEM) does
         the actual recognition, but we still need RECORD_AUDIO because we own the
         microphone session via SpeechRecognizer.startListening(). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Reading and writing system blocked numbers requires either being the default
         dialer / SMS app (which we are) or these privileged permissions. Declaring
         them lets old API levels work even if the app loses its default-dialer role. -->
    <uses-permission android:name="android.permission.READ_BLOCKED_NUMBERS" />
    <uses-permission android:name="android.permission.WRITE_BLOCKED_NUMBERS" />

    <!-- Required for the in-app update check against GitHub Releases and for the
         DownloadManager request that fetches the new APK. The user triggers both
         explicitly from Settings; we never poll silently. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets the in-app updater hand the downloaded APK to the system installer
         without bouncing the user to a browser. Android still shows the standard
         "Install unknown apps" toggle for our package on first use. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".DialerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AccessibleDialer"
        tools:targetApi="34">

        <!-- Main dialer/launcher activity. Registered with intent filters required
             so the system recognizes this app as a candidate Default Phone App. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.AccessibleDialer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Dialer / Default phone app intent filters -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- Register this app as a Contacts entry on the launcher / app picker, so the
                 user can open it from "Contacts" the same way they open it from "Phone".
                 Tapping that entry simply launches MainActivity; MainActivity inspects the
                 CATEGORY_APP_CONTACTS category and lands the user on the Contacts tab. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_CONTACTS" />
            </intent-filter>
            <!-- Share-text entry point: the system Share sheet routes any plain-text
                 share here. We can't filter by content at the manifest level (intent
                 filters don't see EXTRA_TEXT), so we always appear; if the shared text
                 doesn't contain a phone number we surface a toast and exit, otherwise
                 we re-use the Call / Add to contact / Cancel prompt. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- In-call full screen UI launched by the InCallService -->
        <activity
            android:name=".call.InCallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|uiMode"
            android:theme="@style/Theme.AccessibleDialer" />

        <!-- InCallService: required to be the default dialer and handle calls -->
        <service
            android:name=".call.DialerInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- CallScreeningService: auto-rejects incoming calls whose number is on the
             system block list. Only one screening service runs at a time and the
             default dialer wins, so this is invoked for every incoming call while
             this app is the default dialer. -->
        <service
            android:name=".blocking.BlockingCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Receives the action buttons on the ongoing-call notification
             (Answer / Decline / Mute / Speaker / Hang up). Not exported — only
             our own PendingIntents target this component, which set it
             explicitly by class. Declaring it in the manifest (instead of
             registering at runtime in DialerInCallService) is what lets
             explicit-component PendingIntents actually deliver: runtime
             receivers have no component name, so explicit broadcasts skip
             them entirely on modern Android. -->
        <receiver
            android:name=".call.InCallActionReceiver"
            android:exported="false" />
    </application>

    <!-- Lets us discover the system speech recognizer service from the foreground
         app (Android 11+ package visibility). Without this, SpeechRecognizer can
         report "no recognizer available" on devices with Google app installed. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Account authenticators that own contact storage accounts so we can
             resolve a human label (the same string Settings → Accounts shows)
             via AccountManager.getAuthenticatorTypes() / PackageManager. Without
             this, Android 11+ package visibility hides the authenticator and the
             editor's "Saved in" dropdown falls back to raw package names. -->
        <intent>
            <action android:name="android.accounts.AccountAuthenticator" />
        </intent>
        <!-- Sync adapters tied to a contact storage account use this intent as
             their service entry point; we read it to resolve a label when a
             package ships a sync adapter without a separate authenticator. -->
        <intent>
            <action android:name="android.content.SyncAdapter" />
        </intent>
    </queries>
</manifest>
