    <string name="user_guide_title">User guide</string>
    <string name="user_guide_intro">A quick tour of every screen and tool. Tap a section to read more.</string>

    <string name="user_guide_section_getting_started">Getting started</string>
    <string name="user_guide_body_getting_started">When prompted, set Accessible Dialer as your default phone app so it can place and receive calls. Grant the Contacts, Call log, and Phone permissions when asked. You can change the theme and text size at any time from Settings → Display.</string>

    <string name="user_guide_section_dialpad">Dialpad</string>
    <string name="user_guide_body_dialpad">Tap digits to enter a number, then press the green Call button. Long-press 0 to type the “+” symbol for international numbers. Backspace removes one digit; long-press it to clear everything. Speed-dial slots 1–9 can be assigned in Settings → Calling.</string>

    <string name="user_guide_section_favorites">Favorites</string>
    <string name="user_guide_body_favorites">Starred contacts appear here as large tiles for one-tap calling. Open a contact’s details and tap the star icon to add or remove it from Favorites.</string>

    <string name="user_guide_section_contacts">Contacts</string>
    <string name="user_guide_body_contacts">Browse the full contact list, search by name or number, or tap the microphone to search by voice. The “+” button opens the editor to create a new contact. Tap any contact to open details with call, edit, share, and delete actions. Use the filter to show contacts from a specific account only.</string>

    <string name="user_guide_section_recents">Recents</string>
    <string name="user_guide_body_recents">Your call history with incoming, outgoing, and missed calls. Tap a row to see options or long-press it for more. Unknown numbers can be saved as a new contact or added to an existing one. Use the overflow menu to clear the entire history.</string>

    <string name="user_guide_section_in_call">During a call</string>
    <string name="user_guide_body_in_call">Large buttons let you mute, switch to speaker, put the call on hold, open the dialpad to send tones, or end the call. The screen stays on while the call is active so the controls remain reachable.</string>

    <string name="user_guide_section_blocking">Blocking and quiet hours</string>
    <string name="user_guide_body_blocking">Block individual numbers in Settings → Tools → Blocked numbers, or turn on “Block unknown callers” to reject anyone not in your contacts. Quiet hours silently reject low-priority calls during the window you choose.</string>

    <string name="user_guide_section_duplicates">Find duplicates</string>
    <string name="user_guide_body_duplicates">Scans your contacts for duplicates by name or phone number. Review each match and merge them with one tap; the original entries are combined into a single contact and nothing is lost.</string>

    <string name="user_guide_section_storage">Storage locations</string>
    <string name="user_guide_body_storage">Shows which account (Google, SIM, or phone) each contact lives in. From here you can bulk-move contacts to a different account or delete every contact from a single account at once.</string>

    <string name="user_guide_section_name_tools">Name fix and normalize</string>
    <string name="user_guide_body_name_tools">Name fix repairs formatting problems such as swapped first and last names or extra whitespace. Name normalize standardizes spelling variants of the same name (for example Mohamed, Mohammad, Mahamed) into one canonical form across your contacts.</string>

    <string name="user_guide_section_import_export">Import and export</string>
    <string name="user_guide_body_import_export">Use Settings → Tools → Import contacts to read a .vcf file, or Export to save your contacts as .vcf or .csv for backup or transfer to another device.</string>

    <string name="user_guide_section_accessibility">Accessibility</string>
    <string name="user_guide_body_accessibility">Increase the text size in Settings → Display. In Settings → Accessibility you can turn on haptic feedback for dialpad keys, verbose digit announcement, and shake-to-answer for incoming calls. Every screen is fully labeled for TalkBack.</string>
