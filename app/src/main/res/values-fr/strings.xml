    <string name="settings_section_help">Aide</string>
    <string name="settings_user_guide">Guide d\'utilisation</string>
    <string name="settings_user_guide_sub">Comment utiliser Accessible Dialer</string>
    <string name="user_guide_title">Guide d\'utilisation</string>
    <string name="user_guide_intro">Une visite rapide de chaque écran et outil. Touchez une section pour en savoir plus.</string>

    <string name="user_guide_section_getting_started">Premiers pas</string>
    <string name="user_guide_body_getting_started">Lorsque vous y êtes invité, définissez Accessible Dialer comme application téléphonique par défaut afin qu\'il puisse passer et recevoir des appels. Accordez les autorisations Contacts, Journal d\'appels et Téléphone lorsqu\'elles sont demandées. Vous pouvez modifier à tout moment le thème et la taille du texte dans Paramètres → Affichage.</string>

    <string name="user_guide_section_dialpad">Clavier</string>
    <string name="user_guide_body_dialpad">Touchez les chiffres pour saisir un numéro, puis appuyez sur le bouton vert d\'appel. Maintenez le 0 enfoncé pour insérer le symbole « + » pour les numéros internationaux. La touche retour arrière efface un chiffre ; maintenez-la pour tout effacer. Les emplacements d\'appel rapide 1 à 9 se règlent dans Paramètres → Appels.</string>

    <string name="user_guide_section_favorites">Favoris</string>
    <string name="user_guide_body_favorites">Les contacts marqués d\'une étoile apparaissent ici sous forme de grandes tuiles pour appeler en un seul toucher. Ouvrez la page de détails d\'un contact et touchez l\'icône en forme d\'étoile pour l\'ajouter aux favoris ou l\'en retirer.</string>

    <string name="user_guide_section_contacts">Contacts</string>
    <string name="user_guide_body_contacts">Parcourez la liste complète des contacts, recherchez par nom ou par numéro, ou touchez le microphone pour une recherche vocale. Le bouton « + » ouvre l\'éditeur pour créer un contact. Touchez un contact pour en voir les détails avec les actions appel, modifier, partager et supprimer. Utilisez le filtre pour n\'afficher que les contacts d\'un compte précis.</string>

    <string name="user_guide_section_recents">Récents</string>
    <string name="user_guide_body_recents">Votre historique des appels entrants, sortants et manqués. Touchez une ligne pour voir les options ou maintenez-la pour en avoir davantage. Les numéros inconnus peuvent être enregistrés comme nouveau contact ou ajoutés à un contact existant. Utilisez le menu supplémentaire pour effacer tout l\'historique.</string>

    <string name="user_guide_section_in_call">Pendant un appel</string>
    <string name="user_guide_body_in_call">De grands boutons vous permettent de couper le micro, de passer au haut-parleur, de mettre en attente, d\'ouvrir le clavier pour envoyer des tonalités ou de raccrocher. L\'écran reste allumé pendant l\'appel pour que les commandes restent accessibles.</string>

    <string name="user_guide_section_blocking">Blocage et heures de calme</string>
    <string name="user_guide_body_blocking">Bloquez des numéros individuels dans Paramètres → Outils → Numéros bloqués, ou activez « Bloquer les appelants inconnus » pour rejeter toute personne ne figurant pas dans vos contacts. Les heures de calme rejettent silencieusement les appels de faible priorité pendant la plage horaire choisie.</string>

    <string name="user_guide_section_duplicates">Trouver les doublons</string>
    <string name="user_guide_body_duplicates">Analyse vos contacts à la recherche de doublons par nom ou par numéro de téléphone. Vérifiez chaque correspondance et fusionnez-les d\'un seul toucher ; les entrées originales sont combinées en un seul contact, sans aucune perte.</string>

    <string name="user_guide_section_storage">Emplacements de stockage</string>
    <string name="user_guide_body_storage">Indique dans quel compte (Google, SIM ou téléphone) se trouve chaque contact. Vous pouvez ici déplacer en masse des contacts vers un autre compte ou supprimer en une fois tous les contacts d\'un compte donné.</string>

    <string name="user_guide_section_name_tools">Corriger et normaliser les noms</string>
    <string name="user_guide_body_name_tools">« Corriger les noms » répare les problèmes de mise en forme tels que prénom et nom inversés ou espaces superflus. « Normaliser les noms » uniformise les variantes orthographiques d\'un même nom (par exemple Mohamed, Mohammad, Mahamed) en une seule forme canonique dans tous vos contacts.</string>

    <string name="user_guide_section_import_export">Importer et exporter</string>
    <string name="user_guide_body_import_export">Utilisez Paramètres → Outils → Importer des contacts pour lire un fichier ‎.vcf, ou Exporter pour enregistrer vos contacts au format ‎.vcf ou ‎.csv pour sauvegarde ou transfert vers un autre appareil.</string>

    <string name="user_guide_section_accessibility">Accessibilité</string>
    <string name="user_guide_body_accessibility">Augmentez la taille du texte dans Paramètres → Affichage. Dans Paramètres → Accessibilité, vous pouvez activer le retour haptique des touches du clavier, l\'annonce détaillée des chiffres et la réponse par secousse aux appels entrants. Chaque écran est entièrement étiqueté pour TalkBack.</string>
</resources>
