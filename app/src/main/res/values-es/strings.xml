    <!-- User guide -->
    <string name="settings_section_help">Ayuda</string>
    <string name="settings_user_guide">Guía del usuario</string>
    <string name="settings_user_guide_sub">Cómo usar Accessible Dialer</string>
    <string name="user_guide_title">Guía del usuario</string>
    <string name="user_guide_intro">Un recorrido rápido por cada pantalla y herramienta. Toca una sección para leer más.</string>

    <string name="user_guide_section_getting_started">Primeros pasos</string>
    <string name="user_guide_body_getting_started">Cuando se te pida, establece Accessible Dialer como tu aplicación de teléfono predeterminada para que pueda realizar y recibir llamadas. Concede los permisos de Contactos, Registro de llamadas y Teléfono cuando se soliciten. Puedes cambiar el tema y el tamaño del texto en cualquier momento desde Ajustes → Pantalla.</string>

    <string name="user_guide_section_dialpad">Teclado</string>
    <string name="user_guide_body_dialpad">Toca los dígitos para introducir un número y luego pulsa el botón verde de llamada. Mantén pulsado el 0 para escribir el símbolo “+” en números internacionales. La tecla de retroceso borra un dígito; mantenla pulsada para borrarlo todo. Las marcaciones rápidas del 1 al 9 se pueden asignar en Ajustes → Llamadas.</string>

    <string name="user_guide_section_favorites">Favoritos</string>
    <string name="user_guide_body_favorites">Los contactos marcados con estrella aparecen aquí como mosaicos grandes para llamar con un solo toque. Abre los detalles de un contacto y toca el icono de estrella para añadirlo o quitarlo de Favoritos.</string>

    <string name="user_guide_section_contacts">Contactos</string>
    <string name="user_guide_body_contacts">Explora la lista completa de contactos, busca por nombre o número, o toca el micrófono para buscar por voz. El botón “+” abre el editor para crear un contacto nuevo. Toca cualquier contacto para abrir los detalles con acciones de llamar, editar, compartir y eliminar. Usa el filtro para mostrar solo los contactos de una cuenta concreta.</string>

    <string name="user_guide_section_recents">Recientes</string>
    <string name="user_guide_body_recents">Tu historial de llamadas entrantes, salientes y perdidas. Toca una fila para ver opciones o mantenla pulsada para más. Los números desconocidos se pueden guardar como contacto nuevo o añadir a uno existente. Usa el menú de opciones adicionales para borrar todo el historial.</string>

    <string name="user_guide_section_in_call">Durante una llamada</string>
    <string name="user_guide_body_in_call">Botones grandes te permiten silenciar, cambiar a altavoz, poner en espera, abrir el teclado para enviar tonos o terminar la llamada. La pantalla permanece encendida mientras la llamada está activa para que los controles sigan accesibles.</string>

    <string name="user_guide_section_blocking">Bloqueo y horario silencioso</string>
    <string name="user_guide_body_blocking">Bloquea números individuales en Ajustes → Herramientas → Números bloqueados, o activa “Bloquear llamadas desconocidas” para rechazar a quien no esté en tus contactos. El horario silencioso rechaza sin sonido las llamadas de baja prioridad durante el periodo que elijas.</string>

    <string name="user_guide_section_duplicates">Buscar duplicados</string>
    <string name="user_guide_body_duplicates">Analiza tus contactos en busca de duplicados por nombre o número de teléfono. Revisa cada coincidencia y combínalos con un solo toque; las entradas originales se unen en un único contacto y no se pierde nada.</string>

    <string name="user_guide_section_storage">Ubicaciones de almacenamiento</string>
    <string name="user_guide_body_storage">Muestra en qué cuenta (Google, SIM o teléfono) reside cada contacto. Desde aquí puedes mover en bloque contactos a otra cuenta o eliminar de una sola vez todos los contactos de una cuenta concreta.</string>

    <string name="user_guide_section_name_tools">Arreglar y normalizar nombres</string>
    <string name="user_guide_body_name_tools">Arreglar nombres corrige problemas de formato, como nombres y apellidos intercambiados o espacios sobrantes. Normalizar nombres unifica variantes ortográficas del mismo nombre (por ejemplo Mohamed, Mohammad, Mahamed) en una única forma canónica en todos tus contactos.</string>

    <string name="user_guide_section_import_export">Importar y exportar</string>
    <string name="user_guide_body_import_export">Usa Ajustes → Herramientas → Importar contactos para leer un archivo ‎.vcf, o Exportar para guardar tus contactos como ‎.vcf o ‎.csv y hacer copia de seguridad o transferirlos a otro dispositivo.</string>

    <string name="user_guide_section_accessibility">Accesibilidad</string>
    <string name="user_guide_body_accessibility">Aumenta el tamaño del texto en Ajustes → Pantalla. En Ajustes → Accesibilidad puedes activar la respuesta háptica para las teclas del teclado, el anuncio detallado de dígitos y contestar con sacudida cuando entra una llamada. Todas las pantallas están totalmente etiquetadas para TalkBack.</string>
</resources>
